# Template for the repo-root .env (gitignored). Locally the .env is a 1Password
# Environment mount (named pipe); keep these keys in the 1Password environment.
# Read by the backend's typed settings (Env in backend/config/settings/base.py) and by compose.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Postgres (compose service "db"; host port 55432, offset to avoid clashing with other local Postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=clearpath
POSTGRES_USER=clearpath
POSTGRES_PASSWORD=clearpath-dev

# Redis (Celery broker)
REDIS_URL=redis://localhost:56379/0

# SPA origin, used in links allauth emails out
FRONTEND_BASE_URL=http://localhost:5173

# Drift monitor demo pages (/demo-partners/<slug>/) as the worker fetches them. Defaults to FRONTEND_BASE_URL
# (in production, the CloudFront site). Under compose the worker reaches the web container as http://web:8000.
# DEMO_PARTNERS_BASE_URL=http://localhost:8000

# LLM checks and assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Demo logins (manage.py seed_demo_users): marketer@, reviewer@, lead@, admin@clearpath.demo
# Must satisfy the password validators (12+ characters, not common).
DEMO_USER_PASSWORD=change-me-demo-password
